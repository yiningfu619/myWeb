somx_3 = 3
somy_3 = 1
cat("=== RUNNING 3-CLUSTER SOLUTION ===\n")
opt.seed_3 <- som.seed(data=SOM_data, nstart=10, iter.max=10000,
somx=somx_3, somy=somy_3, grid.topo="hexagonal")
set.seed(opt.seed_3)
ex.som3 <- som(X=data.matrix(SOM_data), grid=somgrid(somx_3, somy_3, "hexagonal"),
rlen=10000, mode="online")
# Reorder clusters by size (descending)
ex.som3 <- reorder_som_by_size(ex.som3)
ex.summ3 <- som.fit.summ(ex.som3)
cat("\n3-Cluster Model Stats:\n")
print(ex.summ3$MODEL_STATS)
cat("\n3-Cluster Frequencies:\n")
print(ex.summ3$FREQ)
# 4 clusters
somx_4 = 4
somy_4 = 1
cat("\n\n=== RUNNING 4-CLUSTER SOLUTION ===\n")
opt.seed_4 <- som.seed(data=SOM_data, nstart=10, iter.max=10000,
somx=somx_4, somy=somy_4, grid.topo="hexagonal")
set.seed(opt.seed_4)
ex.som4 <- som(X=data.matrix(SOM_data), grid=somgrid(somx_4, somy_4, "hexagonal"),
rlen=10000, mode="online")
# Reorder clusters by size (descending)
ex.som4 <- reorder_som_by_size(ex.som4)
ex.summ4 <- som.fit.summ(ex.som4)
cat("\n4-Cluster Model Stats:\n")
print(ex.summ4$MODEL_STATS)
cat("\n4-Cluster Frequencies:\n")
print(ex.summ4$FREQ)
# 5 clusters
somx_5 = 5
somy_5 = 1
cat("\n\n=== RUNNING 5-CLUSTER SOLUTION ===\n")
opt.seed_5 <- som.seed(data=SOM_data, nstart=10, iter.max=10000,
somx=somx_5, somy=somy_5, grid.topo="hexagonal")
set.seed(opt.seed_5)
ex.som5 <- som(X=data.matrix(SOM_data), grid=somgrid(somx_5, somy_5, "hexagonal"),
rlen=10000, mode="online")
# Reorder clusters by size (descending)
ex.som5 <- reorder_som_by_size(ex.som5)
ex.summ5 <- som.fit.summ(ex.som5)
cat("\n5-Cluster Model Stats:\n")
print(ex.summ5$MODEL_STATS)
cat("\n5-Cluster Frequencies:\n")
print(ex.summ5$FREQ)
# 6 clusters
somx_6 = 6
somy_6 = 1
cat("\n\n=== RUNNING 6-CLUSTER SOLUTION ===\n")
opt.seed_6 <- som.seed(data=SOM_data, nstart=10, iter.max=10000,
somx=somx_6, somy=somy_6, grid.topo="hexagonal")
set.seed(opt.seed_6)
ex.som6 <- som(X=data.matrix(SOM_data), grid=somgrid(somx_6, somy_6, "hexagonal"),
rlen=10000, mode="online")
# Reorder clusters by size (descending)
ex.som6 <- reorder_som_by_size(ex.som6)
ex.summ6 <- som.fit.summ(ex.som6)
cat("\n6-Cluster Model Stats:\n")
print(ex.summ6$MODEL_STATS)
cat("\n6-Cluster Frequencies:\n")
print(ex.summ6$FREQ)
# Plot 3-cluster solution
cat("\n=== 3-CLUSTER SOLUTION ===\n")
map.profile.plot(ex.som3, legend.loc = "bottom", lab.cex = 1.2,
leg.sym.cex = 2.5, leg.lab.cex = 0.7)
# Plot 4-cluster solution
cat("\n=== 4-CLUSTER SOLUTION ===\n")
map.profile.plot(ex.som4, legend.loc="bottom", lab.cex=1.2,
leg.sym.cex = 2.5, leg.lab.cex=0.7)
# Plot 5-cluster solution
cat("\n=== 5-CLUSTER SOLUTION ===\n")
map.profile.plot(ex.som5, legend.loc="bottom", lab.cex=1.2,
leg.sym.cex = 2.5, leg.lab.cex=0.7)
# Plot 6-cluster solution
cat("\n=== 6-CLUSTER SOLUTION ===\n")
map.profile.plot(ex.som6, legend.loc="bottom", lab.cex=1.2,
leg.sym.cex = 2.5, leg.lab.cex=0.7)
# Save all cluster solutions
# 3-cluster solution
SOM_3_me1 <- ex.summ3$PREDICTIONS %>%
dplyr::select(ID) %>%
rename(SOM_3_ClusterID = ID)
# 4-cluster solution
SOM_4_me1 <- ex.summ4$PREDICTIONS %>%
dplyr::select(ID) %>%
rename(SOM_4_ClusterID = ID)
# 5-cluster solution
SOM_5_me1 <- ex.summ5$PREDICTIONS %>%
dplyr::select(ID) %>%
rename(SOM_5_ClusterID = ID)
# 6-cluster solution
SOM_6_me1 <- ex.summ6$PREDICTIONS %>%
dplyr::select(ID) %>%
rename(SOM_6_ClusterID = ID)
# Combine all solutions into one dataframe
SOM_all_me1 <- bind_cols(SOM_3_me1, SOM_4_me1, SOM_5_me1, SOM_6_me1)
# View summary
cat("\n=== CLUSTER ASSIGNMENT SUMMARY ===\n")
cat("Total observations:", nrow(SOM_all_me1), "\n\n")
cat("3-Cluster distribution:\n")
print(table(SOM_all_me1$SOM_3_ClusterID))
cat("\n4-Cluster distribution:\n")
print(table(SOM_all_me1$SOM_4_ClusterID))
cat("\n5-Cluster distribution:\n")
print(table(SOM_all_me1$SOM_5_ClusterID))
cat("\n6-Cluster distribution:\n")
print(table(SOM_all_me1$SOM_6_ClusterID))
# View first few rows
cat("\n")
head(SOM_all_me1)
