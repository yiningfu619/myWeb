library(knitr)
# Results from Cluster Model Stats
# 1. Input the scaled WITHIN and BETWEEN data
wcss_values <- c(1574072.0, 389618.7, 587372.9)
bcss_values <- c(3200.903, 2761.862, 1987.687)
# 2. Calculate the Sum of Squares totals
total_wcss <- sum(wcss_values)
total_bcss <- sum(bcss_values)
tss <- total_wcss + total_bcss
# 3. Construct the updated Sum of Squares Table
ss_table <- data.frame(
Source = c("Between Clusters (BCSS)", "Within Clusters (WCSS)", "Total (TSS)"),
Sum_of_Squares = c(total_bcss, total_wcss, tss),
Percentage = c(
paste0(round((total_bcss / tss) * 100, 2), "%"),
paste0(round((total_wcss / tss) * 100, 2), "%"),
"100.00%"
)
)
# 4. Print the formatted Markdown table
kable(ss_table,
format = "markdown",
align = "lcc",
caption = "Sum of Squares Table for Scaled SOM 3-Cluster Solution",
col.names = c("Source of Variation", "Sum of Squares", "Percentage of Variance"))
# 1. Input the scaled WITHIN and BETWEEN data
wcss_values <- c(1570550.0, 418139.0, 173447.6, 154773.5)
bcss_values <- c(3618.508, 1985.860, 1985.838, 2663.105)
# 2. Calculate the Sum of Squares totals
total_wcss <- sum(wcss_values)
total_bcss <- sum(bcss_values)
tss <- total_wcss + total_bcss
# 3. Construct the updated Sum of Squares Table
ss_table <- data.frame(
Source = c("Between Clusters (BCSS)", "Within Clusters (WCSS)", "Total (TSS)"),
Sum_of_Squares = c(total_bcss, total_wcss, tss),
Percentage = c(
paste0(round((total_bcss / tss) * 100, 2), "%"),
paste0(round((total_wcss / tss) * 100, 2), "%"),
"100.00%"
)
)
# 4. Print the formatted Markdown table
kable(ss_table,
format = "markdown",
align = "lcc",
caption = "Sum of Squares Table for Scaled SOM 4-Cluster Solution",
col.names = c("Source of Variation", "Sum of Squares", "Percentage of Variance"))
