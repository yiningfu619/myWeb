library(factoextra)
library(cluster)
# ==============================================================================
# Elbow Method (WSS)
# ==============================================================================
# We apply this directly to 'SOM_data' since it is already scaled and prepared
elbow_plot <- fviz_nbclust(SOM_data,
FUNcluster = kmeans,
method = "wss",
k.max = 12) + # Testing 1 to 10 clusters
labs(title = "Elbow Method for Optimal k (SOM_data)",
x = "Number of Clusters (k)",
y = "Total Within Sum of Square (WSS)") +
theme_minimal()
print(elbow_plot)
# ==============================================================================
# Silhouette Method
# ==============================================================================
sil_plot <- fviz_nbclust(SOM_data,
FUNcluster = kmeans,
method = "silhouette",
k.max = 12) +
labs(title = "Silhouette Method for Optimal k (SOM_data)",
x = "Number of Clusters (k)",
y = "Average Silhouette Width") +
theme_minimal()
print(sil_plot)
