library(gtsummary)
library(forcats)
table_data <- NBHD_cleaned %>%
bind_cols(ClusterID = SOM_all_me1$SOM_6_ClusterID) %>%
mutate(ClusterID = fct_infreq(as.factor(ClusterID)),
ClusterID = factor(as.numeric(ClusterID))
) %>%
dplyr::select(
ClusterID,
pctNonHispWhite,
pctPoor,
pctUnemployedCLF,
pctManProfOccs,
pctLivingAlone,
pctMarried,
pctLessThan9th,
pctSameHouse,
pctOwnerOcc,
pctNoVehicles,
CEN_POPDENSITY_TRACT,
WUSTL_AVG_PM25,
PEI,
pct_SingleParents
)
table_6clusters <- table_data %>%
tbl_summary(
by = ClusterID,
statistic = list(
all_continuous() ~ "{median} ({p25}, {p75})"
),
digits = all_continuous() ~ 2,
missing = "no",
label = list(
pctNonHispWhite ~ "Non-Hispanic White (%)",
pctPoor ~ "Below poverty line (%)",
pctUnemployedCLF ~ "Unemployed civilian labor force (%)",
pctManProfOccs ~ "Management & Professional Occs (%)",
pctLivingAlone ~ "Living alone (%)",
pctMarried ~ "Married (%)",
pctLessThan9th ~ "Less than 9th grade (%)",
pctSameHouse ~ "Same house as year prior (%)",
pctOwnerOcc ~ "Owner-occupied housing (%)",
pctNoVehicles ~ "No vehicles available (%)",
CEN_POPDENSITY_TRACT ~ "Population density (Census Tract)",
WUSTL_AVG_PM25 ~ "PM2.5 Annual Mean (μg/m3)",
PEI ~ "Pedestrian Environment Index",
pct_SingleParents ~ "Single Parents (%)"
)
) %>%
add_overall() %>%
bold_labels() %>%
modify_header(label = "**Neighborhood Characteristics**")
